# Copy to .env and fill in. .env is gitignored and MUST NOT be committed.
#
#   cp .env.example .env
#   chmod 600 .env          # readable only by you
#   $EDITOR .env
#
# Everything here is consumed by ./build-and-push-external.sh. Nothing in this file is
# read by the application itself — the dashboard never sees registry credentials.

# ---------------------------------------------------------------------------
# Registry
# ---------------------------------------------------------------------------
# Host only, no scheme and no trailing slash.
REGISTRY=quay.io

# The org/user namespace and image name. Final ref is:
#   $REGISTRY/$REGISTRY_NAMESPACE/$IMAGE_NAME:<version>-<git-sha>
REGISTRY_NAMESPACE=ephico2real
IMAGE_NAME=group-sync-dashboard

# ---------------------------------------------------------------------------
# Credentials  —  NEVER COMMIT THESE
# ---------------------------------------------------------------------------
# For Quay, create a *robot account* (Account Settings -> Robot Accounts) rather than using
# your personal password. A robot token can be revoked on its own without disturbing your
# login, which is what you want if it ever leaks.
#
# Username for a Quay robot looks like:  myorg+myrobot
REGISTRY_USERNAME=<change-me>

# Robot token / password. Treat this like a private key.
#   - do not paste it into chat, tickets, or CI logs
#   - if it is ever exposed, revoke and regenerate it in Quay immediately
#   - prefer exporting it from a secret manager over storing it here at all, e.g.
#       REGISTRY_PASSWORD=$(security find-generic-password -s quay-robot -w)
REGISTRY_PASSWORD=<change-me>

# ---------------------------------------------------------------------------
# Deployment target (optional — only used by --deploy)
# ---------------------------------------------------------------------------
K8S_NAMESPACE=group-sync-dashboard

# Image pull secret name. Leave EMPTY when the registry repository allows public pull,
# which is the common case for a public Quay repo. Set it only for a private repository;
# the deployment then references it and `--create-pull-secret` can create it for you.
IMAGE_PULL_SECRET=
