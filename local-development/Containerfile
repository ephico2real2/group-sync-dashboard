# Two stages so build-time tooling never reaches the runtime image.
#
# Python 3.14 from the RHEL APPSTREAM, deliberately not from python.org. UBI9 ships
# python3.14 (3.14.5 vs python.org's 3.14.6 — Red Hat backports security fixes into
# theirs), and the RPM keeps interpreter CVEs on Red Hat's books: they patch it, a
# rebuild picks it up, and Trivy sees it. A hand-compiled /usr/local python is invisible
# to the rpm database, so every scanner reports a clean image while the interpreter
# quietly ages — the worst of both worlds.
#
# ubi9-minimal for BOTH stages, replacing the old ubi9/python-311 s2i build image (no
# python-314 s2i image exists yet, and none is needed): our own wheel is pure Python and
# every compiled dependency — pydantic-core, uvloop, httptools — ships prebuilt cp314
# wheels, so the "build" stage needs pip, not gcc.
FROM registry.access.redhat.com/ubi9-minimal:latest AS build

USER 0
WORKDIR /build

# update first: the base is rebuilt by Red Hat on their cadence, and this picks up any
# fixes published since, on every one of OUR builds rather than only on theirs.
RUN microdnf update -y \
 && microdnf install -y python3.14 python3.14-pip \
 && microdnf clean all

COPY pyproject.toml README.md ./
COPY gsd ./gsd

# Build a wheel and resolve dependencies into a self-contained prefix, so the runtime
# stage needs no compiler and no package index.
RUN python3.14 -m pip install --no-cache-dir --upgrade pip build \
 && python3.14 -m build --wheel --outdir /wheels \
 && python3.14 -m pip install --no-cache-dir --prefix=/install /wheels/*.whl


FROM registry.access.redhat.com/ubi9-minimal:latest

# Stamped at build time so a running pod can prove which source it was built from.
# This exists because of a real failure: an image was built, the source was then changed,
# and the older image was deployed — the commit contained the fix and the running pod did
# not, with nothing to reveal the gap. GIT_COMMIT carries `-dirty` when the tree had
# uncommitted changes, so a build that no commit can reproduce says so.
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG BUILD_VERSION=unknown

# OpenShift runs containers as an arbitrary high UID in the root group, not as the UID the
# image declares. Anything the process writes at runtime must therefore be group-writable
# and group-owned by root — the SQLite file included.
# Both lib AND lib64: RHEL splits purelib from platlib, so every compiled wheel
# (pydantic_core, uvloop, httptools, _yaml) lands in lib64 while the pure-Python packages
# land in lib. Listing only lib imports pydantic but not pydantic_core.
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/install/lib/python3.14/site-packages:/install/lib64/python3.14/site-packages \
    GSD_CONFIG=/etc/gsd/clusters.yaml \
    GSD_DB_PATH=/data/gsd.db \
    GSD_LOG_LEVEL=INFO \
    GSD_GIT_COMMIT=$GIT_COMMIT \
    GSD_GIT_BRANCH=$GIT_BRANCH \
    GSD_VERSION=$BUILD_VERSION

# OCI-standard labels, so `podman inspect` / `oc image info` answer "what is this?" without
# running it.
LABEL org.opencontainers.image.revision="$GIT_COMMIT" \
      org.opencontainers.image.version="$BUILD_VERSION" \
      org.opencontainers.image.title="group-sync-dashboard" \
      org.opencontainers.image.source="https://github.com/ephico2real2/group-sync-dashboard"
#   GSD_LOG_LEVEL: DEBUG | INFO | WARNING | ERROR | CRITICAL
#   Set explicitly rather than left to the code default so it is discoverable in
#   `podman inspect` / `oc set env --list` — an env var nobody knows exists is not a
#   feature. DEBUG adds per-poll timing, HTTP request lines, page counts and the
#   countdown to the next binding refresh; it is safe to leave on briefly but is chatty
#   at one line or more per poll per cluster.

USER 0
# `update` cannot clear the known curl HIGHs today: CVE-2026-8286, CVE-2026-8925,
# CVE-2026-8927, CVE-2026-9547, CVE-2026-11352 and CVE-2026-11586 against curl-minimal and
# libcurl-minimal all report NO fixed version from Red Hat, and a dry run on a fresh base
# says "Nothing to do". They are also unreachable here — every HTTP call goes through
# Python httpx, nothing shells out to curl, and the HEALTHCHECK below uses urllib.
#
# Two sqlite advisories are in the same position (CVE-2024-0232, CVE-2025-70873): UBI9
# ships only 3.34.1, so they cannot be patched out. sqlite IS used, so gsd/store.py
# disables extension loading to cut the surface instead. See
# docs/image-vulnerability-scan.md.
#
# The update still earns its place: every rebuild of THIS image picks up whatever HAS been
# fixed since Red Hat last rebuilt the base, rather than waiting on their cadence.
# Measured effect when python3.14 landed: MEDIUM 119 -> 113.
# tzdata is REQUIRED, not a convenience, if TZ is ever set.
#
# ubi9-minimal ships without it, and the failure is silent and misleading rather than loud:
# with TZ=America/New_York and no zoneinfo, Python parses the value as a POSIX TZ spec,
# takes "America" as the zone NAME and finds no offset, so it reports
# tzname=('America','America') while localtime stays UTC. Verified in the shipped pod. Logs
# would then be stamped with a New York label over UTC times — worse than leaving TZ unset,
# because it looks configured.
#
# It does not affect stored data: every timestamp in the app is datetime.now(UTC) and every
# stored string ends in Z. This governs log lines only.
RUN microdnf update -y \
 && microdnf install -y python3.14 tzdata \
 && microdnf clean all \
 && rm -rf /var/cache/yum

COPY --from=build /install /install

RUN mkdir -p /data /etc/gsd \
 && chgrp -R 0 /data /etc/gsd \
 && chmod -R g=u /data /etc/gsd

# A non-root default so the image is also safe to run outside OpenShift, where no
# arbitrary UID is assigned.
USER 1001

EXPOSE 8080
VOLUME ["/data"]

# Readiness is deliberately not gated on a reachable cluster: an unreachable cluster is a
# thing this dashboard exists to display, so failing readiness for one would take the
# dashboard down exactly when it has something to report.
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
    CMD ["python3.14", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=2).status==200 else 1)"]

# `python3.14 -m uvicorn`, not the /install/bin/uvicorn console script: that script's
# shebang points at the *build* stage's interpreter path, which does not exist here.
# Single worker on purpose — the poller runs in-process and owns the SQLite store, so a
# second worker would mean two pollers racing on the same file and duplicate observations.
CMD ["python3.14", "-m", "uvicorn", "gsd.api:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8080", "--workers", "1"]
