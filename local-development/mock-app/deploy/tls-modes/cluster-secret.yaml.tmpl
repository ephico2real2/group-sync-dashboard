# The labelled cluster Secret for one mock (docs/specs/SPEC_S1_cluster_secrets.md C1). Rendered by
# deploy-tls-modes.sh: NAME, CLUSTER (the id the dashboard shows), TOKEN (meta.token from the fixture),
# CONFIG (the JSON for the mode under test). The Secret's own name is a convention; the label is what
# the dashboard discovers on.
apiVersion: v1
kind: Secret
metadata:
  name: gsd-cluster-${CLUSTER}
  namespace: group-sync-dashboard
  labels:
    groupsync-dashboard.io/secret-type: cluster
    groupsync-dashboard.io/tls-mode: ${MODE}
    environment: lab
type: Opaque
stringData:
  name: ${CLUSTER}
  server: https://${NAME}:6443
  config: '${CONFIG}'
  visibility: inherit
  identity: same-as-host
