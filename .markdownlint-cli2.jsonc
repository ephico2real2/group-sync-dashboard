{
  // House style: opinionated/cosmetic rules OFF, all real-bug rules ON.
  // Mirrors the convention used across the operator's other repos.
  "config": {
    "default": true,
    "MD013": false, // line-length — prose docs are not hard-wrapped
    "MD060": false, // table-column-style — pedantic pipe spacing
    "MD022": false, // blanks-around-headings
    "MD032": false, // blanks-around-lists
    "MD026": false, // trailing-punctuation-in-heading
    "MD024": { "siblings_only": true } // allow same heading text under different sections
  },
  "ignores": [
    "node_modules/**",
    ".git/**",
    ".venv/**",
    "venv/**",
    // Feature specifications are the design agents' text VERBATIM, sliced by heading and
    // re-concatenated to the byte before being written (docs/specs/README.md). Their bodies
    // carry a second H1, heading jumps and HTML element names in prose; restyling six hundred
    // spots by hand in code-bearing text is the rewriting the programme forbids. Exempt, like
    // the review records are from the citation rule. The index README in that directory is
    // hand-written and is NOT exempt.
    "docs/specs/SPEC_*.md"
  ]
}
